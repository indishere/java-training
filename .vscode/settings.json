{
    "java.jdt.ls.java.home":  "${env:JAVA_HOME}",
    "terminal.integrated.env.windows":  {
                                            "Path":  "${env:JAVA_HOME}\\bin;${env:Path}"
                                        },
    "java.project.referencedLibraries":  [
                                             "frogger-game/lib/*.jar"
                                         ],
    "code-runner.executorMap":  {
                                    "java":  "cd /d \"$dir\" && \"%JAVA_HOME%\\bin\\javac.exe\" -J-XX:+AutoCreateSharedArchive -J-XX:SharedArchiveFile=\"%TEMP%\\javac-cache.jsa\" -J-XX:TieredStopAtLevel=1 -J-XX:+UseSerialGC -sourcepath . -cp \"lib\\*\" \"$fileName\" &&\"%JAVA_HOME%\\bin\\java.exe\" -cp \".;lib\\*\" \"$fileNameWithoutExt\""
                                },
    "code-runner.executorMapByGlob":  {
                                          "compile-java":  "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"Invoke-Expression ([System.IO.File]::ReadAllText('$fullFileName'))\""
                                      }
}
